{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "@wdio/globals/types"
    ]
  },
  "include": [
    "config/**/*.ts",
    "src/**/*.ts",
    "wdio.*.conf.ts",
    "scripts/**/*.ts"
  ]
}
