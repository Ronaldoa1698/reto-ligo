{
  "name": "ligo-mobile-tests",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "test": "wdio run ./wdio.android.conf.ts",
    "android": "wdio run ./wdio.android.conf.ts",
    "test:smoke": "TEST_TAG=@smoke wdio run ./wdio.android.conf.ts",
    "test:regression": "TEST_TAG=@regression wdio run ./wdio.android.conf.ts",
    "typecheck": "tsc --noEmit",
    "features:check": "node --import tsx node_modules/@cucumber/cucumber/bin/cucumber.js --import 'src/steps/**/*.ts' --import 'src/hooks/**/*.ts' 'src/features/**/*.feature' --dry-run --format summary",
    "app:download": "node --import tsx scripts/download-app.ts",
    "driver:install": "APPIUM_HOME=\"$PWD/.cache/appium\" appium driver install uiautomator2@8.7.3",
    "doctor": "APPIUM_HOME=\"$PWD/.cache/appium\" appium driver doctor uiautomator2",
    "report": "allure generate allure-results --clean -o allure-report",
    "report:open": "allure open allure-report"
  },
  "devDependencies": {
    "@cucumber/cucumber": "13.2.1",
    "@types/node": "24.19.2",
    "@wdio/allure-reporter": "10.2.0",
    "@wdio/appium-service": "10.2.0",
    "@wdio/cli": "10.2.0",
    "@wdio/cucumber-framework": "10.2.0",
    "@wdio/globals": "10.2.0",
    "@wdio/junit-reporter": "10.2.0",
    "@wdio/local-runner": "10.2.0",
    "@wdio/spec-reporter": "10.2.0",
    "@wdio/types": "10.2.0",
    "allure-commandline": "2.36.0",
    "appium": "3.8.0",
    "ffmpeg-static": "5.3.0",
    "npm": "10.9.4",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
